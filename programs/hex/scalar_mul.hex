// OpenCoreX scalar MUL integration test

// Address 0x00: addi x1, x0, 7
00700093

// Address 0x04: addi x2, x0, 6
00600113

// Address 0x08: mul x3, x1, x2
022081B3

// Address 0x0C: addi x4, x0, -3
FFD00213

// Address 0x10: mul x5, x4, x2
022202B3

// Address 0x14: mul x6, x4, x4
02420333

// Address 0x18: mul x8, x1, x0
02008433

// Address 0x1C: lw x9, 128(x0)
08002483

// Address 0x20: mul x10, x9, x9
// 0x00010000 * 0x00010000 = 0x00000001_00000000
// MUL retains the lower 32 bits, so x10 = 0.
02948533

// Address 0x24: mul x0, x1, x2
// The register-file write must be ignored.
02208033

// Address 0x28: addi x11, x0, 1
// If x0 remained zero, x11 becomes 1.
00100593

// Address 0x2C: lw x31, 160(x0)
0A002F83

// Address 0x30: sw x31, 188(x0)
// Completion transaction.
0BF02E23

// Address 0x34: jal x0, 0
// Safety loop if simulation continues.
0000006F

// Continue initialization at word index 0x20.
// Word index 32 corresponds to byte address 128.
@20

// Large multiplication operand
00010000

// Continue initialization at word index 0x28.
// Word index 40 corresponds to byte address 160.
@28

// ASCII "RKYC" completion signature
524B5943